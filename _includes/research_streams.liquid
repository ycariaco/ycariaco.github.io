<section class="research-streams" id="research-streams" data-default="placenta">
  <div class="rs-header">Research Streams</div>

  <div class="rs-wrap">
    <svg class="rs-svg" viewBox="0 0 960 520" role="img" aria-label="Research streams diagram">
      <defs>
        <linearGradient id="rs-bg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#f8fafc"/>
          <stop offset="100%" stop-color="#ffffff"/>
        </linearGradient>
        <filter id="rs-shadow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="3" stdDeviation="4" flood-color="#1f2937" flood-opacity="0.12"/>
        </filter>
      </defs>

      <rect x="12" y="12" width="936" height="496" rx="16" fill="url(#rs-bg)" stroke="#e5e7eb"/>

      <text class="rs-col-title" x="140" y="36">Prenatal exposures</text>
      <text class="rs-col-title" x="480" y="36" text-anchor="middle">Placenta health &amp; fetal development</text>
      <text class="rs-col-title" x="820" y="36" text-anchor="middle">Analytical tools</text>

      {% assign nodes = site.data.research_streams.nodes %}
      {% assign links = site.data.research_streams.links %}

      {% for link in links %}
        {% assign from_node = nodes | where: "id", link.from | first %}
        {% assign to_node = nodes | where: "id", link.to | first %}
        {% if from_node and to_node %}
          {% assign c1x = from_node.x | plus: 120 %}
          {% assign c2x = to_node.x | minus: 120 %}
          <path
            class="rs-link"
            data-from="{{ link.from }}"
            data-to="{{ link.to }}"
            d="M {{ from_node.x }} {{ from_node.y }} C {{ c1x }} {{ from_node.y }}, {{ c2x }} {{ to_node.y }}, {{ to_node.x }} {{ to_node.y }}"
          ></path>
        {% endif %}
      {% endfor %}

      {% for node in nodes %}
        {% assign label_x = node.x %}
        {% assign label_y = node.y | plus: 4 %}
        {% assign label_anchor = "middle" %}

        {% if node.group == "exposure" %}
          {% assign label_x = node.x | plus: 56 %}
          {% assign label_anchor = "start" %}
        {% elsif node.group == "tool" or node.group == "integration" %}
          {% assign label_x = node.x | minus: 56 %}
          {% assign label_anchor = "end" %}
        {% elsif node.group == "core" %}
          {% assign label_y = node.y | plus: 52 %}
        {% endif %}

        <g
          class="rs-node group-{{ node.group }}"
          data-id="{{ node.id }}"
          data-desc="{{ node.desc | escape }}"
          role="button"
          tabindex="0"
          aria-pressed="false"
          filter="url(#rs-shadow)"
        >
          <circle cx="{{ node.x }}" cy="{{ node.y }}" r="{{ node.r }}"></circle>

          {% assign parts = node.label | split: " / " %}
          <text class="rs-label" x="{{ label_x }}" y="{{ label_y }}" text-anchor="{{ label_anchor }}">
            {% for part in parts %}
              <tspan x="{{ label_x }}" dy="{% if forloop.first %}0{% else %}1.1em{% endif %}">{{ part }}</tspan>
            {% endfor %}
          </text>
        </g>
      {% endfor %}
    </svg>

    <div class="rs-panel" id="rs-panel">
      <div class="rs-title">Hover or tap a stream</div>
      <div class="rs-body">Details appear here.</div>
      <div class="rs-hint">Tip: click to lock a selection on mobile.</div>
    </div>
  </div>
</section>

<script>
(() => {
  const root = document.getElementById("research-streams");
  if (!root) return;

  const panelTitle = root.querySelector(".rs-title");
  const panelBody = root.querySelector(".rs-body");
  const nodes = root.querySelectorAll(".rs-node");
  const links = root.querySelectorAll(".rs-link");

  function activate(node) {
    const id = node.dataset.id;
    panelTitle.textContent = node.textContent.trim().replace(/\s+/g, " ");
    panelBody.textContent = node.dataset.desc || "";

    nodes.forEach(n => n.classList.remove("active"));
    links.forEach(l => l.classList.remove("active"));

    node.classList.add("active");
    links.forEach(l => {
      if (l.dataset.from === id || l.dataset.to === id) l.classList.add("active");
    });
  }

  nodes.forEach(n => {
    n.addEventListener("mouseenter", () => activate(n));
    n.addEventListener("click", () => activate(n));
    n.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        activate(n);
      }
    });
  });

  const defaultId = root.dataset.default;
  const defaultNode = root.querySelector(`.rs-node[data-id="${defaultId}"]`) || nodes[0];
  if (defaultNode) activate(defaultNode);
})();
</script>

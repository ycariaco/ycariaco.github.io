<section class="research-streams dark" id="research-streams" data-default="placenta">
  <div class="rs-header">Research Streams</div>

  <div class="rs-wrap">
    <svg class="rs-svg" viewBox="0 0 1100 600" role="img" aria-label="Research streams diagram">
      <defs>
        <filter id="rs-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="6" result="blur"/>
          <feMerge>
            <feMergeNode in="blur"/>
            <feMergeNode in="SourceGraphic"/>
          </feMerge>
        </filter>
      </defs>

      <rect x="12" y="12" width="1076" height="576" rx="18" class="rs-bg"/>

      <text class="rs-col-title exposure" x="140" y="48">Prenatal exposures</text>
      <text class="rs-col-title core" x="550" y="48" text-anchor="middle">Placenta health &amp; fetal development</text>
      <text class="rs-col-title tools" x="940" y="48" text-anchor="middle">Analytical tools</text>

      <!-- center image -->
      <image
        href="{{ '/assets/img/research/placenta.png' | relative_url }}"
        x="430"
        y="165"
        width="240"
        height="210"
        preserveAspectRatio="xMidYMid meet"
      />

      {% assign nodes = site.data.research_streams.nodes %}
      {% assign links = site.data.research_streams.links %}

      {% for link in links %}
        {% assign from_node = nodes | where: "id", link.from | first %}
        {% assign to_node = nodes | where: "id", link.to | first %}
        {% if from_node and to_node %}
          {% assign c1x = from_node.x | plus: 140 %}
          {% assign c2x = to_node.x | minus: 140 %}
          <path
            class="rs-link"
            data-from="{{ link.from }}"
            data-to="{{ link.to }}"
            d="M {{ from_node.x }} {{ from_node.y }} C {{ c1x }} {{ from_node.y }}, {{ c2x }} {{ to_node.y }}, {{ to_node.x }} {{ to_node.y }}"
          ></path>
        {% endif %}
      {% endfor %}

      {% for node in nodes %}
        {% assign label_x = node.x %}
        {% assign label_y = node.y | plus: 4 %}
        {% assign label_anchor = "middle" %}

        {% if node.group == "exposure" %}
          {% assign label_x = node.x | plus: 60 %}
          {% assign label_anchor = "start" %}
        {% elsif node.group == "tool" or node.group == "integration" %}
          {% assign label_x = node.x | minus: 60 %}
          {% assign label_anchor = "end" %}
        {% elsif node.group == "core" %}
          {% assign label_y = node.y | plus: 56 %}
        {% endif %}

        <g
          class="rs-node group-{{ node.group }}"
          data-id="{{ node.id }}"
          data-desc="{{ node.desc | escape }}"
          role="button"
          tabindex="0"
          aria-pressed="false"
        >
          <circle cx="{{ node.x }}" cy="{{ node.y }}" r="{{ node.r }}"></circle>

          {% assign parts = node.label | split: " / " %}
          <text class="rs-label" x="{{ label_x }}" y="{{ label_y }}" text-anchor="{{ label_anchor }}">
            {% for part in parts %}
              <tspan x="{{ label_x }}" dy="{% if forloop.first %}0{% else %}1.2em{% endif %}">{{ part }}</tspan>
            {% endfor %}
          </text>
        </g>
      {% endfor %}
    </svg>

    <div class="rs-panel" id="rs-panel">
      <div class="rs-title">Hover or tap a stream</div>
      <div class="rs-body">Details appear here.</div>
      <div class="rs-hint">Click to lock on mobile. Click another to switch.</div>
    </div>
  </div>
</section>

<script>
(() => {
  const root = document.getElementById("research-streams");
  if (!root) return;

  const panelTitle = root.querySelector(".rs-title");
  const panelBody = root.querySelector(".rs-body");
  const nodes = root.querySelectorAll(".rs-node");
  const links = root.querySelectorAll(".rs-link");

  let locked = null;

  function setActive(node) {
    const id = node.dataset.id;
    panelTitle.textContent = node.textContent.trim().replace(/\s+/g, " ");
    panelBody.textContent = node.dataset.desc || "";

    nodes.forEach(n => n.classList.remove("active"));
    links.forEach(l => l.classList.remove("active"));

    node.classList.add("active");
    links.forEach(l => {
      if (l.dataset.from === id || l.dataset.to === id) l.classList.add("active");
    });
  }

  nodes.forEach(n => {
    n.addEventListener("mouseenter", () => {
      if (locked) return;
      setActive(n);
    });

    n.addEventListener("click", () => {
      if (locked === n) {
        locked = null;
        return;
      }
      locked = n;
      setActive(n);
    });

    n.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        locked = n;
        setActive(n);
      }
    });
  });

  const defaultId = root.dataset.default;
  const defaultNode = root.querySelector(`.rs-node[data-id="${defaultId}"]`) || nodes[0];
  if (defaultNode) setActive(defaultNode);
})();
</script>
